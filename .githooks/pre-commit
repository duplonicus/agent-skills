#!/usr/bin/env bash
# Pre-commit hook: block commits whose staged additions contain a known secret
# pattern. Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

if [ -z "$(git diff --cached --name-only --diff-filter=ACM)" ]; then
  exit 0
fi

patterns=(
  'ops_[A-Za-z0-9._-]{20,}'              # 1Password service account tokens
  'sk-ant-[A-Za-z0-9_-]{20,}'            # Anthropic API keys
  'sk-[A-Za-z0-9]{20,}'                  # OpenAI-style keys
  'AIza[A-Za-z0-9_-]{20,}'               # Google API keys
  'gho_[A-Za-z0-9]{20,}'                 # GitHub OAuth tokens
  'ghp_[A-Za-z0-9]{20,}'                 # GitHub PATs
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'   # Any private key
  '"refresh_token"\s*:\s*"[^"]{20,}"'    # OAuth refresh tokens in JSON
  '"client_secret"\s*:\s*"[^"]{20,}"'    # OAuth client secrets
)

status=0
diff_added=$(git diff --cached --diff-filter=ACM | grep -E "^\+" || true)
for p in "${patterns[@]}"; do
  if printf '%s\n' "$diff_added" | grep -Eq -- "$p"; then
    echo "pre-commit: suspected secret pattern detected ($p)." >&2
    status=1
  fi
done
exit $status
